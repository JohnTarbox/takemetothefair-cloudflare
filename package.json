{
  "name": "takemetothefair-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "mcp-server",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint src mcp-server/src packages/*/src",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "typecheck:mcp": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit -p mcp-server/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:mcp",
    "cf:build": "opennextjs-cloudflare build --dangerously-use-unsupported-next-version",
    "cf:preview": "opennextjs-cloudflare build --dangerously-use-unsupported-next-version && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build --dangerously-use-unsupported-next-version && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --strict-vars false cloudflare-env.d.ts && cd mcp-server && wrangler types --env-interface WorkerEnv --strict-vars false worker-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply takemetothefair-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply takemetothefair-db --remote",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:backup": "bash scripts/db-backup.sh prod",
    "db:backup:local": "bash scripts/db-backup.sh local",
    "db:restore": "bash scripts/db-restore.sh",
    "db:restore:prod": "bash scripts/db-restore.sh",
    "db:backups": "bash scripts/db-list-backups.sh",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:all": "npm test -- --run && npm test --workspace mcp-server && npm test --workspaces --if-present",
    "pretest:e2e": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "PLAYWRIGHT_BASE_URL=https://meetmeatthefair.com playwright test e2e/smoke.spec.ts --project=chromium",
    "test:sweep": "npx tsx scripts/fairground-sweep.ts",
    "gvalidate": "npx tsx gvalidate/index.ts",
    "gvalidate:all": "npx tsx gvalidate/index.ts --no-fail-fast",
    "gvalidate:vendors": "npx tsx gvalidate/index.ts --type=vendor",
    "gvalidate:events": "npx tsx gvalidate/index.ts --type=event",
    "gvalidate:venues": "npx tsx gvalidate/index.ts --type=venue",
    "gvalidate:quick": "npx tsx gvalidate/index.ts --limit=3",
    "gvalidate:urls": "npx tsx gvalidate/index.ts --urls-only",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:typecheck": "wrangler types --env-interface CloudflareEnv --strict-vars false cloudflare-env.d.ts --check && cd mcp-server && wrangler types --env-interface WorkerEnv --strict-vars false worker-env.d.ts --check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@johntarbox/calendar-grid": "^0.1.0",
    "@jonnyboats/calendar-contract": "^1.2.0",
    "@jonnyboats/calendar-core": "^1.2.0",
    "@jonnyboats/calendar-react": "^1.2.0",
    "@next/third-parties": "^15.5.28",
    "@takemetothefair/constants": "*",
    "@takemetothefair/datetime": "*",
    "@takemetothefair/event-series": "*",
    "@takemetothefair/site-fetch": "*",
    "@takemetothefair/utils": "*",
    "@takemetothefair/validation": "*",
    "@takemetothefair/vendor-linking": "*",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.563.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "rehype-external-links": "^3.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.16",
    "web-vitals": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.28",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "next": "15.5.28",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "fast-uri": "^3.1.8",
    "ip-address": "^10.7.4",
    "browserslist": "^4.28.9",
    "next": {
      "postcss": "^8.5.28"
    },
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2"
  },
  "browserslist": [
    "defaults",
    "Safari >= 14",
    "iOS >= 14",
    "Chrome >= 90",
    "Firefox >= 88",
    "Edge >= 90",
    "not dead",
    "not op_mini all"
  ]
}
